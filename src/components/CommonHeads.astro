---
const { pathname } = Astro.url;
const canonicalPath = pathname.endsWith("/") ? pathname : `${pathname}/`;
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url).href;
---

<meta charset="utf-8" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />

<!-- darkreader lock -->
<meta name="darkreader-lock" />

<!-- --------------- SEO BEGIN --------------- -->
<meta property="og:url" content={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />
<!-- --------------- SEO END   --------------- -->

<!-- google fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Allura&family=Pinyon+Script&display=swap"
  rel="stylesheet"
/>
