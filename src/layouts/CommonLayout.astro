---
import "../style/global.css";
import CommonHeads from "../components/CommonHeads.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
}

const { title = "Home - Aromia" } = Astro.props;
---

<html lang="en" data-theme="dark">
  <head>
    <CommonHeads />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Allura&family=Pinyon+Script&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-bg-color text-text-primary">
    <Header />
    <div class="mx-auto min-h-auto max-w-4xl min-w-0 px-3 py-4">
      <slot />
      <Footer />
    </div>
  </body>
</html>
